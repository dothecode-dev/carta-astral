# Molde del entorno de staging local. Copiar a `.env.staging` y completar.
#
#   cp .env.staging.example .env.staging
#
# `.env.staging` está ignorado por git. Este archivo, que SÍ se versiona, no
# lleva ningún valor real: el repositorio es público.
#
# Los puertos son distintos a los de `make dev` (8000/3000) a propósito, para
# poder tener los dos entornos levantados al mismo tiempo sin pisarse.

# --- Puertos del host ---
# 5435 y no 5433: el 5433 es el "segundo Postgres" por convención y lo toma
# cualquier otro compose de la máquina. El 03-09-2026 `make test-back-pg` corrió
# contra la base de otro proyecto por eso. Si igual choca, cambialo acá: el
# target lo verifica antes de correr y aborta con el conflicto a la vista.
DB_PORT=5435
BACK_PORT=8001
WEB_PORT=3002

# --- Base de staging ---
# Base propia y vacía. NUNCA restaurar acá un dump de producción: en esa base
# hay cuentas reales con sus direcciones de mail.
POSTGRES_USER=astra
POSTGRES_PASSWORD=cambiar-por-cualquier-cosa-local
POSTGRES_DB=astra_staging

# --- Django ---
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1,backend
CSRF_TRUSTED_ORIGINS=http://localhost:8001,http://localhost:3002
WAGTAILADMIN_BASE_URL=http://localhost:8001
WEB_BASE_URL=http://localhost:3002
GUNICORN_WORKERS=3

# --- Interpretación ---
# Con una key real, staging gasta plata de verdad en cada lectura. Dejala vacía
# salvo que estés probando la generación a propósito.
ANTHROPIC_API_KEY=
INTERPRETATION_DAILY_CAP=50

# --- Login de la web ---
# Vacío => /api/auth/google responde 503, que es lo correcto si no vas a probar
# el login. Para probarlo, el mismo client id que usás en desarrollo.
GOOGLE_AUD=
NEXT_PUBLIC_GOOGLE_CLIENT_ID=

# --- Créditos ---
INSTALL_FREE_CREDITS=1

# --- Web ---
NEXT_PUBLIC_SITE_URL=http://localhost:3002
# Vacío a propósito: staging no manda eventos a la analítica de producción.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Paneles ---
# Rutas no obvias, igual que en producción. Vacías => los paneles no se montan.
ADMIN_URL=
WAGTAIL_ADMIN_URL=

# --- Cobro con Polar (cuando exista) ---
# SIEMPRE claves de sandbox acá. El RF7 de la spec de cobro pide que el backend
# falle al arrancar si el entorno y las claves no coinciden, justamente para que
# staging no pueda acreditar créditos con las credenciales de producción.
