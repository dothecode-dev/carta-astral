# Copiar a .env.local para desarrollar contra el backend de la máquina.
#   cp web/.env.example web/.env.local
#
# API_URL sólo se lee en el servidor de Next (lib/sky.ts), nunca en el navegador:
# por eso no lleva el prefijo NEXT_PUBLIC_. En producción no hace falta definirla,
# el default ya apunta al backend desplegado.
API_URL=http://localhost:8000

# Origen del sitio, para canonical, hreflang y Open Graph. En producción tampoco
# hace falta: el default es https://astra.dothecode.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Client ID de tipo Web de Google. Es público: viaja en el HTML, por eso NEXT_PUBLIC_.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com

# Token de proyecto de PostHog (analítica de producto). Es público por diseño:
# sólo permite escribir eventos, por eso lleva NEXT_PUBLIC_. Sin él la web no
# inicializa PostHog y toda la telemetría queda en no-op — que es exactamente
# lo que tiene que pasar en el build con las variables vacías.
#
# Va VACÍO a propósito: `make install` copia este archivo a `.env.local`, y con
# un valor de ejemplo un clon nuevo saldría mandando eventos reales a PostHog
# con un token inventado. Para medir en desarrollo, pegá el token en .env.local.
NEXT_PUBLIC_POSTHOG_KEY=

# Verificación de propiedad de Google Search Console, método "etiqueta HTML".
# Hoy va vacío A PROPÓSITO y no hay que completarlo: astraguia.com está
# verificado por DNS, con un registro TXT `google-site-verification` en Route 53
# que no hay que borrar. Esto queda como segunda vía por si alguna vez se pierde
# ese TXT o hay que verificar otro dominio; vacío, la etiqueta ni se emite.
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=
