# Copiar a .env.local para desarrollar contra el backend de la máquina.
#   cp web/.env.example web/.env.local
#
# API_URL sólo se lee en el servidor de Next (lib/sky.ts), nunca en el navegador:
# por eso no lleva el prefijo NEXT_PUBLIC_. En producción no hace falta definirla,
# el default ya apunta al backend desplegado.
API_URL=http://localhost:8000

# Origen del sitio, para canonical, hreflang y Open Graph. En producción tampoco
# hace falta: el default es https://astra.dothecode.com.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Client ID de tipo Web de Google. Es público: viaja en el HTML, por eso NEXT_PUBLIC_.
NEXT_PUBLIC_GOOGLE_CLIENT_ID=tu-client-id.apps.googleusercontent.com
