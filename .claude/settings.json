{
  "$comment": "Permisos compartidos del proyecto (versionados). Sólo comandos de desarrollo y verificación, sin nada que exponga credenciales. Lo personal de cada máquina va en .claude/settings.local.json, que está ignorado por git.",
  "permissions": {
    "allow": [
      "Bash(make install)",
      "Bash(make dev)",
      "Bash(make back)",
      "Bash(make web)",
      "Bash(make stop)",
      "Bash(make test)",
      "Bash(make test-back)",
      "Bash(make test-web)",
      "Bash(make sky)",
      "Bash(uv sync*)",
      "Bash(uv run pytest*)",
      "Bash(uv run ruff check*)",
      "Bash(uv run lint-imports)",
      "Bash(uv run mypy*)",
      "Bash(uv run python manage.py check*)",
      "Bash(uv run python manage.py makemigrations --check*)",
      "Bash(DEBUG=1 uv run pytest*)",
      "Bash(.venv/bin/python -m pytest*)",
      "Bash(DEBUG=1 .venv/bin/python -m pytest*)",
      "Bash(.venv/bin/ruff check*)",
      "Bash(.venv/bin/lint-imports)",
      "Bash(.venv/bin/mypy*)",
      "Bash(npm ci)",
      "Bash(npm install)",
      "Bash(npm test*)",
      "Bash(npm run build)",
      "Bash(npm run check:legal)",
      "Bash(npx eslint*)",
      "Bash(npx tsc --noEmit*)",
      "Bash(npx vitest*)",
      "Bash(git status*)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git branch*)",
      "Bash(git show*)"
    ],
    "deny": [
      "Read(./backend/.env)",
      "Read(./web/.env.local)",
      "Read(./**/*.p8)",
      "Read(./**/*.pem)",
      "Read(./**/*.keystore)",
      "Bash(git add -f*)"
    ]
  }
}
