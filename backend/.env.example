# Molde del .env del backend. Copiar a `backend/.env` y completar.
#
# El repositorio es PÚBLICO: acá va el nombre de la variable y, como mucho, un
# valor de ejemplo. Nunca el real. `tests/test_env_example.py` verifica que este
# archivo esté completo y que no se filtre ningún secreto.
#
# En desarrollo alcanza con DEBUG=1: casi todo lo demás tiene default.

# --- Obligatorias en producción (sin ellas el proceso no arranca) ---
SECRET_KEY=cambiar-por-una-clave-larga-y-aleatoria
DATABASE_URL=postgres://usuario:clave@host:5432/base
ALLOWED_HOSTS=api.midominio.com
CSRF_TRUSTED_ORIGINS=https://api.midominio.com
WAGTAILADMIN_BASE_URL=https://api.midominio.com
WEB_BASE_URL=https://midominio.com
# Cache compartida entre workers: sin esto el lock que impide generar dos veces
# la misma lectura no existe, y los topes de costo no limitan nada.
USE_DB_CACHE=1

# --- Desarrollo ---
DEBUG=0

# --- Interpretación ---
ANTHROPIC_API_KEY=cambiar-por-la-key-de-anthropic
INTERPRETATION_DAILY_CAP=500

# --- Login de la web ---
# Client id de OAuth de Google. Vacío => /api/auth/google responde 503.
GOOGLE_AUD=
GOOGLE_ISS=https://accounts.google.com
GOOGLE_JWKS_URL=https://www.googleapis.com/oauth2/v3/certs
JWKS_TTL_SECONDS=43200
SESSION_TTL_DAYS=90

# --- Créditos ---
INSTALL_FREE_CREDITS=1

# --- Límites de uso (por IP o cuenta, según el endpoint) ---
INTERPRETATION_RATE=20/day
INSTALL_RATE=30/day
AUTH_RATE=30/day
CHART_RATE=60/day
SKY_RATE=240/hour

# --- Admin ---
# Sin estas dos, los paneles no se montan: no existen en el despliegue.
# Se usan rutas no obvias para no regalársela a los bots que escanean.
ADMIN_URL=
WAGTAIL_ADMIN_URL=

# --- Archivos y servidor ---
# Volumen persistente en producción: si no, cada deploy borra las imágenes
# del CMS y deja las referencias colgadas en la base.
MEDIA_ROOT=/data/media
GUNICORN_WORKERS=3

# --- Revalidación de la web ---
REVALIDATE_URL=
REVALIDATE_SECRET=

# =====================================================================
# Superficie de la app móvil — APAGADA
# =====================================================================
# La app no se retoma por ahora: lo que se termina es la web. Nada de esto
# se borró; se dejó dormido. Para reactivarlo, descomentar el flag de la
# plataforma que vuelva y completar sus credenciales.
#
# Son dos flags y no uno porque lo más probable es que la app vuelva por una
# plataforma antes que por la otra.

# --- Login con Apple (sólo app iOS) ---
# APP_AUTH_ENABLED=1
# APPLE_AUD=
# APPLE_ISS=https://appleid.apple.com
# APPLE_JWKS_URL=https://appleid.apple.com/auth/keys
# Credenciales del server API de Apple: hacen falta para el revoke del borrado
# de cuenta (guideline 5.1.1(v)). Fail-open: sin ellas el login anda igual.
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# --- Compras in-app vía RevenueCat (iOS y Android) ---
# IAP_WEBHOOK_ENABLED=1
# REVENUECAT_WEBHOOK_AUTH=
# Mapa product_id -> créditos que otorga, en JSON.
# REVENUECAT_PRODUCT_CREDITS={"credits_10": 10}
# REFUND_FLAG_THRESHOLD=3
