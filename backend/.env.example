# Copiar a backend/.env y completar. Ese archivo está en .gitignore y NUNCA se commitea:
# este repo es público.
#
#   cp backend/.env.example backend/.env
#
# Para desarrollo local casi todo tiene default razonable. Lo único que hace falta de
# verdad es ANTHROPIC_API_KEY, y sólo si vas a generar interpretaciones.

# --- Básico ---------------------------------------------------------------------
# DEBUG lo pone el Makefile en desarrollo (make dev / make back). Con DEBUG apagado,
# SECRET_KEY es obligatoria o el proceso no arranca.
# SECRET_KEY=
# ALLOWED_HOSTS=api.ejemplo.com
# CSRF_TRUSTED_ORIGINS=https://ejemplo.com

# Sin definir usa SQLite en backend/db.sqlite3. Ojo: los tests de concurrencia y la
# idempotencia del webhook de pagos sólo son fieles contra Postgres, que es lo que
# corre el CI.
# DATABASE_URL=postgres://carta:carta@localhost:5432/carta

# Cache en la base, como producción. El Makefile ya lo activa en desarrollo.
# USE_DB_CACHE=1

# --- Interpretación (Claude) ----------------------------------------------------
# Sin esta clave, el endpoint de interpretación no genera texto.
ANTHROPIC_API_KEY=

# Tope diario global de interpretaciones y créditos de regalo al instalar.
# INTERPRETATION_DAILY_CAP=500
# INSTALL_FREE_CREDITS=1

# --- SSO --------------------------------------------------------------------------
# Vacíos, el login de ese proveedor responde 503 (fail-closed) en vez de aceptar
# cualquier token. En local se dejan vacíos salvo que estés probando el login.
# GOOGLE_AUD=   # OAuth client id
# APPLE_AUD=    # bundle id de la app iOS

# Sólo para revocar el token de Apple al borrar una cuenta. APPLE_PRIVATE_KEY es el
# contenido PEM del .p8: va como variable de entorno, el archivo nunca al repo.
# APPLE_TEAM_ID=
# APPLE_KEY_ID=
# APPLE_PRIVATE_KEY=

# --- Pagos (RevenueCat) -----------------------------------------------------------
# REVENUECAT_WEBHOOK_AUTH=
# REVENUECAT_PRODUCT_CREDITS={"producto_id": 10}
# REFUND_FLAG_THRESHOLD=3

# --- Web y CMS --------------------------------------------------------------------
# WEB_BASE_URL=http://localhost:3000
# WAGTAILADMIN_BASE_URL=http://localhost:8000
# Para que el CMS avise a la web que revalide una página publicada.
# REVALIDATE_URL=
# REVALIDATE_SECRET=
